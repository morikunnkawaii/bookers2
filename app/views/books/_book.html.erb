<div class="col-md-3">
  <h2>User info</h2>
  <%= image_tag user.get_profile_image(100, 100) %>
  <table class="table">
    <tbody>
      <tr></tr>
      <tr>
        <th>名前</th>
        <th><%= user.name %></th>
      </tr>
      <tr>
        <th>自己紹介文</th>
        <th><%= user.introduction %></th>
      </tr>
    </tbody>
  </table>
  <div class="row">
    <%= link_to edit_user_path(user.id), class: "btn btn-outline-secondary btn-block" do %>
      <i class="fa-solid fa-user-gear"></i>
    <% end %>
  </div>
  <h2 class="mt-3">New book</h2>
  <%= form_with model: booknew do |f| %>
    <div class="form-group">
      <label for="book_title">本のタイトル</label>
      <%= f.text_field :title, id:"book_title",class:"form-control book_title" %>
    </div>
    <div class="form-group">
      <label for="book_body">感想</label>
      <%= f.text_area :body, id:"book_body", class:"form-control book_body" %>
    </div>
    <div class="form-group">
      <%= f.submit 'Create Book', class:"btn btn-success" %>
    </div>
  <% end %>
</div>
<!-- 部分テンプレートはインスタンス変数ではなくローカル変数を使う -->
<!-- プロフィール編集でedit_user_path(Current.user.id)にしていた為、アクセス制限がかかることなくログインしているユーザーeditに飛んでいた。Currentを無くすことで、そのユーザーのIDを引っ張ってくる為制限がかかり自分のuser showへリダイレクトされるようになった -->
