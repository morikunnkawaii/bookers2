<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0">
      <h2>Log in </h2>
      <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
      <%= form_with url: session_path do |form| %>
        <div class="field">
          <label for="user_name">Name</label>
          <br>
          <%= form.text_field :name, required: true, autofocus: true, autocomplete: "username", id: "user_name", placeholder: "Enter your name", value: params[:name] %>
        </div>
        <div class="field">
          <label for="user_password">Password</label>
          <br>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72 %>
        </div>
        <div class="field">
          <%= form.check_box :remember_me, id:"user_remember_me" %>
          <label for="user_remember_me">Remember me</label>
        </div>
        <div class="actions">
          <%= form.submit "Log in", class:"btn btn-sm btn-primary" %>
        </div>
      <% end %>
      <%= link_to "Sing up", new_user_path %>
      <br>
      <%= link_to "Forgot password?", new_password_path %>
    </div>
  </div>
</div>