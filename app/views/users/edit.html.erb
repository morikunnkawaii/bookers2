<h2>User info</h2>
<%= form_with model: @user do |f| %>
  <label for="inputName">名前</label>
  <%= f.text_field :name, autofocus: true, id:"inputName", placeholder:"名前を入力してください" %>
  <label for="inputImage">Image</label>
  <%= f.file_field :profile_image, placeholder: "プロフィール画像", accept: "image/*" %>
  <label for="inputIntroduction">自己紹介文</label>
  <%= f.text_field :introduction, id:"inputIntroduction", placeholder:"自己紹介文を入力してください" %> 
  <%= f.submit "変更を保存" %>
<% end %> 
<!--autofocus:trueはカーソルを合わせなくてもすぐに入力できる記述 -->
<!--placeholderは入力していないフォームの中に薄っすら表示される文字 -->