<%= render 'book', user:@user, booknew:@booknew %>
<!-- 部分テンプレート、user:@userのuserの中に@userをいれるという意味部分テンプレートにあるローカル変数userへ渡される -->
<h1>Book detail</h1>
<div>
  <p><%= image_tag @book.user.get_profile_image(100,100) %></p>
  <p>
    <%= link_to user_path(@user.id) do %>
      <%= @book.user.name %>
    <% end %>
  </p>
  <p>本のタイトル
    <%= link_to book_path(@book.id) do %>
      <%= @book.title %>
    <% end %>
  </p>
  <p>感想<%= @book.body %></p>
 
    
  <% if @book.user == Current.user %>
    <%= link_to "Edit", edit_book_path %>
    <%= link_to "destroy", book_path(@book), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？"  } %>
  <% end %>
</div>