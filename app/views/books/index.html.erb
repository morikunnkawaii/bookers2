<% if @book.errors.any? %>
  <%= pluralize(@book.errors.count, 'error') %>
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= render 'book', books:@book %>

<h1>Books</h1>
<% @books.each do |book| %>
  <div>
    <p><%= image_tag book.user.get_profile_image(100,100) %></p>
    <p>本のタイトル
      <%= link_to book_path(book.id) do %>
        <%= book.title %>
      <% end %>
    </p>
    <p>感想<%= book.body %></p>
  </div>
<% end %>

