<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
      <h1>Editing Book</h1>
      <% if @book.errors.any? %>
        <%= pluralize(@book.errors.count, 'error') %>
        <ul>
          <% @book.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
      <%= form_with model: @book do |f| %>
        <div class="form-group">
          <div class="field_with_errors">
            <label for="title">本のタイトル</label>
          </div>
          <div class="field_with_errors">
            <%= f.text_field :title, id:"title", class:"form-control book_title" %>
          </div>
        </div>
        <div class="form-group">
          <div class="field_with_errors">
            <label for="body">感想</label>
          </div>
          <div class="field_with_errors">
            <%= f.text_field :body, id:"body", class:"form-control book_title" %>
          </div>
        </div>
        <div class="form-group">
          <%= f.submit "Update Book", class:"btn btn-success" %>
        </div>
      <% end %>
      <%= link_to "Show", book_path(@book.id) %>
      |
      <%= link_to "Back", books_path %>
    </div>
  </div>
</div>