<h2>User info</h2>
<%= image_tag @book.user.get_profile_image(100, 100) %>
<h3>名前<%= @book.user.name %></h3>
<h3>自己紹介文<%= @book.user.introduction %></h3>
<h1>New book</h1>
<%= form_with model: @book do |f| %>
  <h4>本のタイトル</h4>
  <%= f.text_field :title %>
  <h4>感想</h4>
  <%= f.text_area :body %>
  <%= f.submit 'Create Book' %>
<% end %>