<div class="container">
  <div class="row">
    <%= render 'book', user:@user, booknew:@booknew %>
    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>
      <table class="table">
        <tbody>
          <tr>
            <td>
              <%= image_tag @book.user.get_profile_image(100,100) %>
              <br>
              <%= link_to user_path(@user.id) do %>
                <%= @book.user.name %>
              <% end %>
            </td>
            <td>
              <%= link_to book_path(@book.id) do %>
                <%= @book.title %>
              <% end %>
            </td>
            <td>
              <%= @book.body %></p>
            </td>
            <td>
              <% if @book.user == Current.user %>
                <%= link_to "Edit", edit_book_path, class:"btn btn-sm btn-success" %>
              <% end %>
            </td>
            <td>
              <% if @book.user == Current.user %>
                <%= link_to "Destroy", book_path(@book), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？"  }, class:"btn btn-sm btn-danger" %>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 部分テンプレート、user:@userのuserの中に@userをいれるという意味部分テンプレートにあるローカル変数userへ渡される -->