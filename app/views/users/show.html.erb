<div>
  <%= image_tag @user.get_profile_image(100, 100) %>
  <h3>名前<%= @user.name %></h3>
  <h3>自己紹介文<%= @user.introduction %></h3>
  <p><%= link_to "プロフィール編集", edit_user_path %></p>
</div>

<h1>Books</h1>
<div>
  <%= image_tag @user.get_profile_image(100, 100) %>
  <% @books.each do |book| %>
    <p>本のタイトル
      <%= link_to book_path(book.id) do %>
        <%= book.title %>
      <% end %>
    </p>
    <p>感想<%= book.body %></p>
  <% end %>
</div>