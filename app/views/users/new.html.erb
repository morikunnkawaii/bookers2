<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0">
      <h2>Sign up</h2>
      <%= form_with model: @user, url: users_path do |f| %>
        <% if @user.errors.any? %>
          <div id="error_explanation">
            <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
            <ul>
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="field">
          <label for="inputName">名前</label>
          <br>
          <%= f.text_field :name, autofocus: true, id:"inputName" %>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <br>
          <%= f.email_field :email_address, id: "email" %>
        </div>

        <div class="field">
          <label for="Inputpassword">Password</label>
          <em>(6 characters minimum)</em>
          <br>
          <%= f.password_field :password, id: "Inputpassword" %>
        </div>

        <div class="field">
          <label for="Inputpassword_confirmation">Password confirmation</label>
          <br>
          <%= f.password_field :password_confirmation, id:"Inputpassword_confirmation" %>
        </div>

        <div class="actions">
          <%= f.submit "Sign up", class:"btn btn-sm btn-success" %>
        </div>
      <% end %>
      <%= link_to "Log in", new_session_path %>
      <br>
    </div>
  </div>
</div>
