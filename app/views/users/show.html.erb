<div>
  <h3><%= @user.name %></h3>
  <%= image_tag @user.get_profile_image(100, 100) %>
</div>

<h1>Books</h1>
<div>
  <%= image_tag @user.get_profile_image(100, 100) %>
  <% @books.each do |book| %>
    <p>本のタイトル
      <%= link_to book_path(book.id) do %>
        <%= book.title %>
      <% end %>
    </p>
    <p>感想<%= book.body %></p>
  <% end %>
</div>