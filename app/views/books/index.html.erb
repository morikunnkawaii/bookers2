<h1>New Book</h1>
<%= form_with model: @book do |f| %>
  <h4>本のタイトル</h4>
  <%= f.text_field :title %>
  <h4>感想</h4>
  <%= f.text_area :body %>
  <%= f.submit 'Create Book' %>
<% end %>

<h1>Books</h1>
<% @books.each do |book| %>
  <div>
    <p>本のタイトル<%= book.title %></p>
    <p>感想<%= book.body %></p>
  </div>
<% end %>
